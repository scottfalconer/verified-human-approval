parameters:
    level: 8
    paths:
        - src/core/src
        - src/webauthn/src
        - src/mcp/src
        - src/symfony-bundle/src
        - src/doctrine/src
        - src/store-contracts/src
        - src/store-contracts/bin
        - src/testing/src
        # One store test class that uses ApprovalHistoryContract, so the trait is analyzed in a class that uses it.
        - tests/Contract/SqliteApprovalStoreContractTest.php
        - demo/src
        - src/webauthn/bin
        # The publishing example: its code, its configuration and its entry points. Not config/reference.php, which
        # Symfony generates when the example boots with debug on.
        - examples/doctrine-publishing/src
        - examples/doctrine-publishing/config/packages
        - examples/doctrine-publishing/config/bootstrap.php
        - examples/doctrine-publishing/config/bundles.php
        - examples/doctrine-publishing/config/routes.php
        - examples/doctrine-publishing/config/services.php
        - examples/doctrine-publishing/public/index.php
        - examples/doctrine-publishing/bin/console
        - examples/doctrine-publishing/bin/setup
    tmpDir: .phpstan
    ignoreErrors:
        # The demo's arrays are database rows and form data; the packages declare every array's value type.
        -
            identifier: missingType.iterableValue
            path: demo/src/*

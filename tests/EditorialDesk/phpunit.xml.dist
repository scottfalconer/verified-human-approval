<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php" colors="true" cacheDirectory="var/phpunit-cache" failOnWarning="true" failOnRisky="true" failOnDeprecation="true">
  <testsuites>
    <testsuite name="application-integration"><directory>tests</directory></testsuite>
  </testsuites>
  <php><server name="DOCTRINE_DEPRECATIONS" value="trigger"/></php>
</phpunit>

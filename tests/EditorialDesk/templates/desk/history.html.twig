{% extends 'base.html.twig' %}
{% block title %}Approval history{% endblock %}
{% block body %}<a class="back" href="{{ path('desk') }}">← Workspace</a><div class="page-heading"><p class="eyebrow">RETAINED RECORD</p><h1>Approval history</h1><p class="muted">This history remains available after the page is deleted.</p></div>
<section class="card"><table><thead><tr><th>Requested change</th><th>State</th><th>Approval</th><th>Record</th></tr></thead><tbody>
{% for row in rows %}{% if row.unreadable %}<tr><td>This record cannot be read</td><td>Integrity error</td><td>Cannot be confirmed</td><td>{% if row.owned %}<a href="{{ path('verified_human_approval_review',{id:row.id}) }}">View request</a>{% elseif row.owned is null %}<code>{{ row.id }}</code>{% else %}Another account’s request{% endif %}</td></tr>
{% else %}<tr><td>{{ row.state.request.prepared.display.title }}</td><td>{{ row.integrity ? row.state.status : 'Integrity error' }}</td><td>{{ row.integrity ? (row.state.proof ? 'Passkey recorded' : 'No passkey recorded') : 'Cannot be confirmed' }}</td><td>{% if row.owned %}<a href="{{ path('verified_human_approval_review',{id:row.state.request.id}) }}">View request</a>{% else %}Another account’s request{% endif %}</td></tr>{% endif %}{% else %}<tr><td colspan="4">No requests yet.</td></tr>{% endfor %}</tbody></table></section>{% endblock %}

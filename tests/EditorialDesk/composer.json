{
  "name": "integration-evaluation/editorial-desk",
  "description": "Independent Symfony application evaluating exact human approval for publishing",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-sodium": "*",
    "ext-openssl": "*",
    "doctrine/doctrine-bundle": "^2.18",
    "doctrine/orm": "^3.5",
    "nyholm/psr7": "^1.8",
    "symfony/framework-bundle": "^7.4",
    "symfony/security-bundle": "^7.4",
    "symfony/twig-bundle": "^7.4",
    "symfony/security-csrf": "^7.4",
    "symfony/asset": "^7.4",
    "symfony/translation": "^7.4",
    "symfony/monolog-bundle": "^4.1",
    "symfony/mcp-bundle": "^1.0@beta",
    "verified-human-approval/core": "dev-main",
    "verified-human-approval/webauthn": "dev-main",
    "verified-human-approval/mcp": "dev-main",
    "verified-human-approval/symfony-bundle": "dev-main",
    "verified-human-approval/doctrine": "dev-main"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "^7.4",
    "symfony/css-selector": "^7.4",
    "verified-human-approval/testing": "dev-main",
    "verified-human-approval/store-contracts": "dev-main",
    "symfony/http-client": "^7.4",
    "symfony/mime": "^7.4"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../src/*",
      "options": {
        "symlink": false,
        "versions": {
          "verified-human-approval/core": "dev-main",
          "verified-human-approval/webauthn": "dev-main",
          "verified-human-approval/mcp": "dev-main",
          "verified-human-approval/symfony-bundle": "dev-main",
          "verified-human-approval/doctrine": "dev-main",
          "verified-human-approval/store-contracts": "dev-main",
          "verified-human-approval/testing": "dev-main"
        }
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": false,
    "platform": {
      "php": "8.3.0"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit"
  },
  "extra": {
    "source-integration-package-baseline": "c6a99c3064adc2531559968fe8ace9d3c40c5502"
  }
}

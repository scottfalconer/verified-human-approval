{% extends '@VerifiedHumanApproval/base.html.twig' %}
{% block title %}Connect {{ client.client_name }} · Verified Human Approval{% endblock %}
{% block body %}
<section class="card approval-sheet">
    <p class="eyebrow">Connect an application · Riverside Council</p>
    <h1>Let {{ client.client_name }} act for {{ user.display_name|default('you') }}?</h1>
    <p>It asks to {{ scope_descriptions|join(', ') }}. It returns to <strong>{{ redirect_host }}</strong>{% if metadata_host %} and identifies itself through <strong>{{ metadata_host }}</strong>{% endif %}.</p>
    <p class="statement">{% if rule == 'approval' %}Your role must approve each exact alert with your own passkey on this site. Connecting does not approve anything.{% elseif rule == 'direct' %}Your role can issue alerts directly, so its requests take effect without a passkey.{% else %}Your role cannot issue alerts, so its requests will be refused.{% endif %}</p>
    {% if loopback %}<p class="statement">This application returns only to an address on this computer. Allow it only if you started connecting from an application running here.</p>{% endif %}
    <form method="post">
        {% for name, value in fields %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}
        <input type="hidden" name="_token" value="{{ csrf }}">
        <div class="actions"><button class="primary" name="decision" value="allow">Allow</button><button class="secondary" name="decision" value="deny">Deny</button></div>
    </form>
    <p class="muted small">You can revoke this connection from your account page or the audit log. Tokens last an hour and refresh while in use.</p>
</section>
{% endblock %}

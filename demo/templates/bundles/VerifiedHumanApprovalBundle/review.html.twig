{# Overrides the bundle's review page for this site: a publication shows the final public page. #}
{% extends '@!VerifiedHumanApproval/review.html.twig' %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ path('riverside_styles') }}">{% endblock %}
{% block preview %}
{% set modes = {direct: 'Issue alerts directly', approval: 'Issue alerts only with verified human approval', denied: 'Cannot issue alerts'} %}
{% if prepared.actionId == 'alert.publish' %}
<p class="muted">{% if state.status == 'completed' %}This is the alerts page residents saw once {{ state.proof ? 'you approved it, drawn from the proposal you approved' : 'it was issued, drawn from the stored proposal' }}.{% elseif state.status == 'pending' %}This is the alerts page residents will see, drawn from the frozen proposal with the site’s own template, not from the current draft.{% else %}This is the alerts page this request asked for. The request stopped, so it never issued this alert.{% endif %}</p>
<div class="rc-frame">
    {# Which revision this is, and whether it went live: the same revision the statement names. #}
    {% set badge = {completed: ['pill-live', 'Issued'], pending: ['', 'Frozen preview']}[state.status] ?? ['pill-off', 'Not issued'] %}
    <div class="rc-frame-bar"><span class="rc-frame-url">{{ url('riverside_alerts') }}</span><span class="pill {{ badge[0] }}">{{ badge[1] }} · revision {{ prepared.preconditions.revision }}</span></div>
    <div class="riverside rc-frame-page">{% include 'public/_page.html.twig' with {title: prepared.effect.title, body: prepared.effect.body} only %}</div>
</div>
{% elseif prepared.actionId == 'policy.change' %}
<p class="muted">{% if state.status == 'completed' %}This is the rule change you approved.{% elseif state.status == 'pending' %}This is the rule as it is now and as it will be once you approve.{% else %}This is the rule change this request asked for. The request stopped, so it never changed the rule.{% endif %}</p>
<table class="rule-change">
    <thead><tr><th>Role</th><th>Now</th><th>After approval</th></tr></thead>
    <tbody>
    {% for role, label in {manager: 'Emergency manager', staff: 'County staff'} %}
        <tr{% if prepared.preconditions[role] != prepared.effect[role] %} class="changed"{% endif %}><td>{{ label }}</td><td>{{ modes[prepared.preconditions[role]] }}</td><td>{{ modes[prepared.effect[role]] }}</td></tr>
    {% endfor %}
    </tbody>
</table>
{% if prepared.preconditions.statement != prepared.effect.statement %}<h3>The statement approvers confirm</h3><p class="statement">{{ prepared.effect.statement }}</p>{% endif %}
{% else %}{{ parent() }}{% endif %}
{% endblock %}

{# The consent step of omouren/mcp-oauth-bundle, in the demo's own page. Its controller handles the form; this page only explains. #}
{% extends '@VerifiedHumanApproval/base.html.twig' %}
{% block title %}Connect {{ client_name }} · Verified Human Approval{% endblock %}
{% block body %}
{% set rule = consent_rule() %}
<section class="card approval-sheet">
    <p class="eyebrow">Connect an application · Riverside Council</p>
    <h1>Let {{ client_name }} act for {{ app.user.displayName|default('you') }}?</h1>
    <p>It asks to {{ consent_scopes(app.request.query.get('scope'))|join(', ') }}.{% if redirect_host %} It returns to <strong>{{ redirect_host }}</strong>.{% endif %}</p>
    <p class="statement">{% if rule == 'approval' %}Your role must approve each exact alert with your own passkey on this site. Connecting does not approve anything.{% elseif rule == 'direct' %}Your role can issue alerts directly, so its requests take effect without a passkey.{% else %}Your role cannot issue alerts, so its requests will be refused.{% endif %}</p>
    {% if redirect_host in ['127.0.0.1', 'localhost', '[::1]'] %}<p class="statement">This application returns only to an address on this computer. Allow it only if you started connecting from an application running here.</p>{% endif %}
    <form method="post">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
        <div class="actions"><button class="primary">Allow</button><a class="button secondary" href="{{ path('demo_home') }}">Don’t allow</a></div>
    </form>
    <p class="muted small">You can revoke this connection from your account page or the audit log. Tokens last an hour and refresh while in use, for up to 30 days.</p>
</section>
{% endblock %}

#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__, 2).'/vendor/autoload.php';

use Symfony\Bundle\FrameworkBundle\Console\Application;
use VerifiedHumanApproval\Demo\DemoKernel;

$runtime = getenv('VERIFIED_HUMAN_APPROVAL_RUNTIME') ?: dirname(__DIR__, 2).'/var/demo';
$application = new Application(new DemoKernel($runtime, debug: filter_var(getenv('APP_DEBUG') ?: '0', \FILTER_VALIDATE_BOOL)));
$application->run();

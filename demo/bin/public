#!/bin/sh
# Serves a second copy of the demo on a public HTTPS address through a Cloudflare quick tunnel, for
# claude.ai and phones. Both run under launchd, so they keep running after this terminal closes.
# Usage: public start [--yes] | stop | status | all-clear | reset
# The tunnel's hostname changes each time it starts, and passkeys are tied to the hostname, so a new
# hostname needs a fresh public demo: start says what it would replace and asks first; --yes answers yes.
# all-clear takes the live alert down for another take, keeping accounts, passkeys and connections.
# reset starts a fresh public demo, with new accounts, passkey links and connections, on the same address, which
# this checkout's tunnel must still answer at.
# The tunnel publishes whatever answers on port 8081, so the public demo uses that port and nothing else may while
# it runs: start and reset go no further while anything else holds it, and should either stop short of serving the
# public demo, for whatever reason, this checkout's tunnel stops too. The tunnel's launchd label is one for the
# whole computer, and start, stop and reset touch only a tunnel that this checkout started.
set -eu
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
RUNTIME="$ROOT/var/public-demo"
PORT=8081
LABEL=dev.verified-human-approval.tunnel
LOG="$ROOT/var/public-tunnel.log"
SERVER="$ROOT/demo/bin/server"
USAGE="Usage: $0 start [--yes] | stop | status | all-clear | reset"

# The tunnel's address, read only from the row after the one in which cloudflared says it created the tunnel: the log
# names other addresses too, such as the quick tunnel service's when cloudflared cannot get a tunnel from it.
tunnel_url() { sed -n '/quick Tunnel has been created/{n;p;}' "$LOG" 2>/dev/null | grep -o 'https://[a-z0-9-]*\.trycloudflare\.com' | tail -1 || true; }
demo_origin() { php -r '$s = json_decode((string) @file_get_contents($argv[1]), true); echo is_array($s) ? ($s["origin"] ?? "") : "";' "$RUNTIME/settings.json"; }
# The public demo's own server.
server() { PORT=$PORT VERIFIED_HUMAN_APPROVAL_RUNTIME="$RUNTIME" "$SERVER" "$@"; }
# launchctl's description of the tunnel job, which is empty when there is none.
tunnel_job() { launchctl list "$LABEL" 2>/dev/null || true; }
# Whether the job described in $1 is this checkout's tunnel: it writes to this checkout's log.
started_here() { case "$1" in *"\"$LOG\""*) ;; *) return 1 ;; esac; }
# The checkout that started the tunnel job described in $1, from where it writes its log; empty if that is not one.
checkout_of() {
  log=$(printf '%s\n' "$1" | sed -n 's/^[[:space:]]*"StandardOutPath" = "\(.*\)";$/\1/p')
  case "$log" in */var/public-tunnel.log) echo "${log%/var/public-tunnel.log}" ;; esac
}
# Where the tunnel job described in $1 was started, when that was not here.
started_from() {
  other=$(checkout_of "$1")
  if [ -n "$other" ]; then echo "started from another checkout, $other"; else echo "not started from this checkout"; fi
}

# Stops this checkout's tunnel, if it runs, so that it publishes nothing else.
close_tunnel() {
  started_here "$(tunnel_job)" || return 0
  launchctl remove "$LABEL" 2>/dev/null || true
  echo "Stopped this checkout's tunnel, so that it publishes nothing else."
}

# From here until serve() has the public demo's server answering, this checkout's tunnel stops whenever this
# script does, whatever the reason.
close_tunnel_on_exit() {
  trap close_tunnel EXIT
  trap 'exit 1' HUP INT TERM
}

# Goes no further while the tunnel job described in $1 is not this checkout's. Its label is one for the whole
# computer, and that tunnel publishes whatever answers on PORT, so only one public demo runs at a time.
guard_tunnel() {
  if [ -z "$1" ] || started_here "$1"; then return 0; fi
  other=$(checkout_of "$1")
  if [ -n "$other" ]; then
    echo "The tunnel job $LABEL was started from another checkout, $other. Only one public demo runs on this computer at a time: stop that one first, with $other/demo/bin/public stop."
  else
    echo "The tunnel job $LABEL was not started from this checkout. Only one public demo runs on this computer at a time: stop that one first, or remove its job: launchctl remove $LABEL"
  fi
  exit 1
}

# Goes no further while anything but the public demo's own server holds PORT. This checkout's tunnel stops, taking
# its address with it, so the command to run again is start, even after a reset.
guard_port() {
  held=0
  holder=$(server status) || held=$?
  [ "$held" -ne 0 ] && [ "$held" -ne 3 ] || return 0
  printf '%s\n' "$holder"
  close_tunnel
  echo "The public demo uses port $PORT, which nothing else may use while it runs. Free the port, then run: $0 start"
  exit 1
}

# Replaces the public demo with a fresh one for the address $1. Clients cannot register themselves on it;
# claude.ai names itself with its client ID metadata document instead.
fresh() {
  stopped=$(server stop) || { printf '%s\n' "$stopped"; exit 1; }
  (umask 077; VERIFIED_HUMAN_APPROVAL_RUNTIME="$RUNTIME" VERIFIED_HUMAN_APPROVAL_ORIGIN="$1" VERIFIED_HUMAN_APPROVAL_DYNAMIC_CLIENT_REGISTRATION=0 php "$ROOT/demo/bin/setup.php" --reset > "$ROOT/var/public-demo-setup.txt")
  echo "Fresh public demo for $1; its credentials and passkey links are in var/public-demo-setup.txt"
}

# Starts the public demo's server, which the tunnel may then publish. Should another program have taken the port
# meanwhile, the tunnel stops.
serve() {
  if started=$(server start); then
    printf '%s\n' "$started"
    trap - EXIT HUP INT TERM
    return 0
  fi
  guard_port
  [ -z "$started" ] || printf '%s\n' "$started"
  exit 1
}

start() {
  mkdir -p "$ROOT/var"
  close_tunnel_on_exit
  job=$(tunnel_job)
  guard_tunnel "$job"
  guard_port
  # A tunnel that runs keeps its address; one that starts gets a new one.
  ORIGIN=
  [ -z "$job" ] || ORIGIN=$(tunnel_url)
  CURRENT=$(demo_origin)
  if [ -n "$CURRENT" ] && [ "$CURRENT" != "$ORIGIN" ] && [ "$1" != --yes ]; then
    if [ -n "$ORIGIN" ]; then
      echo "The public demo was set up for $CURRENT, and the tunnel now answers at $ORIGIN."
    else
      echo "The public demo was set up for $CURRENT, and a new tunnel answers at a new address."
    fi
    echo "Passkeys belong to one address, so a demo for the new one replaces this one: its accounts, passkeys, connections, records and signing key."
    answer=
    if [ -t 0 ]; then
      printf 'Replace it? [y/N] '
      read -r answer || answer=
    fi
    case "$answer" in
      y | Y | yes | Yes) ;;
      *) echo "Nothing was replaced. To replace it without being asked: $0 start --yes"; exit 1 ;;
    esac
    # An answer can take a while, so the port is looked at again before the tunnel starts or is kept.
    guard_port
  fi
  if [ -z "$ORIGIN" ]; then
    [ -z "$job" ] || launchctl remove "$LABEL" 2>/dev/null || true
    : > "$LOG"
    launchctl submit -l "$LABEL" -o "$LOG" -e "$LOG" -- "$(command -v cloudflared)" tunnel --no-autoupdate --url "http://localhost:$PORT"
    i=0
    while [ $i -lt 60 ] && [ -z "$(tunnel_url)" ]; do sleep 0.5; i=$((i + 1)); done
    ORIGIN=$(tunnel_url)
    [ -n "$ORIGIN" ] || { echo "The tunnel did not start; see $LOG"; exit 1; }
  fi
  [ "$CURRENT" = "$ORIGIN" ] || fresh "$ORIGIN"
  serve
  echo "Public demo: $ORIGIN"
  echo "claude.ai connector URL: $ORIGIN/mcp"
  echo "The public demo uses port $PORT, which nothing else may use while it runs."
}

reset() {
  close_tunnel_on_exit
  ORIGIN=$(demo_origin)
  [ -n "$ORIGIN" ] || { echo "No public demo to reset; run: $0 start"; exit 1; }
  job=$(tunnel_job)
  guard_tunnel "$job"
  guard_port
  # Only this checkout's running tunnel answers at the demo's address: one that has stopped has lost it, though its
  # log still names it.
  if ! started_here "$job" || [ "$(tunnel_url)" != "$ORIGIN" ]; then
    echo "The public demo was set up for $ORIGIN, and this checkout's tunnel does not answer there."
    close_tunnel
    echo "A reset keeps that address. For a fresh public demo at a new one, run: $0 start"
    exit 1
  fi
  fresh "$ORIGIN"
  serve
}

stop() {
  job=$(tunnel_job)
  if started_here "$job"; then
    launchctl remove "$LABEL" 2>/dev/null || true
  elif [ -n "$job" ]; then
    echo "The tunnel job $LABEL was $(started_from "$job"), and is left running."
  fi
  server stop
}

status() {
  job=$(tunnel_job)
  if [ -z "$job" ]; then
    echo "Tunnel: not running"
  elif started_here "$job"; then
    url=$(tunnel_url)
    echo "Tunnel: ${url:-no address yet; see $LOG}"
  else
    echo "Tunnel: $(started_from "$job")"
  fi
  server status
}

case "${1:-status}" in
  start)
    case "${2:-}" in
      '' | --yes) start "${2:-}" ;;
      *) echo "$USAGE"; exit 2 ;;
    esac ;;
  stop) stop ;;
  status) status ;;
  all-clear) VERIFIED_HUMAN_APPROVAL_RUNTIME="$RUNTIME" php "$ROOT/demo/bin/console" demo:all-clear ;;
  reset) reset ;;
  *) echo "$USAGE"; exit 2 ;;
esac

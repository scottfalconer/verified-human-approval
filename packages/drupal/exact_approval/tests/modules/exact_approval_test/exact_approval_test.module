<?php

declare(strict_types=1);

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\node\NodeInterface;

/**
 * @file
 * Deliberately hostile hooks for the isolated acceptance site only.
 *
 * A real entity hook writes a second database row and then throws after the node
 * mutation. The acceptance runner must observe one rollback covering the node,
 * this side effect, the WebAuthn counter, approval proof, and execution receipt.
 */

/**
 * Implements hook_entity_field_access().
 */
function exact_approval_test_entity_field_access($operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL): AccessResultInterface {
  $rule = \Drupal::state()->get('exact_approval_test.hidden_field', []);
  if ($operation === 'view' && $items !== NULL
    && $field_definition->getName() === ($rule['field'] ?? NULL)
    && $items->getEntity()->uuid() === ($rule['uuid'] ?? NULL)
    && (string) $account->id() === ($rule['uid'] ?? NULL)) {
    return AccessResult::forbidden()->cachePerUser()->setCacheMaxAge(0);
  }
  return AccessResult::neutral();
}

/**
 * Implements hook_entity_update().
 */
function exact_approval_test_entity_update(EntityInterface $entity): void {
  _exact_approval_test_after_mutation($entity, 'update');
}

/**
 * Implements hook_entity_delete().
 */
function exact_approval_test_entity_delete(EntityInterface $entity): void {
  _exact_approval_test_after_mutation($entity, 'delete');
}

/**
 * Injects an explicit failure only for the runner's exact target UUID.
 */
function _exact_approval_test_after_mutation(EntityInterface $entity, string $operation): void {
  if (!$entity instanceof NodeInterface) {
    return;
  }
  $settings = \Drupal::state()->get('exact_approval_test.failure', []);
  if (($settings['uuid'] ?? NULL) !== $entity->uuid() || ($settings['operation'] ?? NULL) !== $operation) {
    return;
  }

  // The normal key/value service caches values in memory, which would obscure
  // whether the database itself rolled back. Use its actual storage table.
  \Drupal::database()->merge('key_value')
    ->keys(['collection' => 'exact_approval_test', 'name' => 'mutation_side_effect'])
    ->fields(['value' => serialize($entity->uuid())])
    ->execute();

  if (in_array($settings['mode'] ?? 'throw', ['alter', 'publish'], TRUE) && $operation === 'update') {
    // Simulate a late hook's additional database mutation, after presave guards.
    // The adapter's fresh persisted postcondition must still reject and roll back.
    $fields = $settings['mode'] === 'publish' ? ['status' => 1] : ['title' => 'Unapproved late hook mutation'];
    \Drupal::database()->update('node_field_data')
      ->fields($fields)
      ->condition('nid', $entity->id())
      ->execute();
    \Drupal::database()->update('node_field_revision')
      ->fields($fields)
      ->condition('nid', $entity->id())
      ->condition('vid', $entity->getRevisionId())
      ->execute();
    return;
  }

  throw new \RuntimeException('Exact approval acceptance fixture: fail after '.$operation.'.');
}

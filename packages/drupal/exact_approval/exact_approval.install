<?php

declare(strict_types=1);

/** Implements hook_schema(). Approval evidence deliberately has no node foreign key. */
function exact_approval_schema(): array {
  $text = ['type' => 'text', 'size' => 'big', 'not null' => TRUE];
  $nullable_text = ['type' => 'text', 'size' => 'big', 'not null' => FALSE];
  $id = ['type' => 'varchar', 'length' => 64, 'not null' => TRUE];
  $schema['exact_approval_mutex'] = [
    'description' => 'Serializes approval transactions before they read authority or target state.',
    'fields' => ['id' => ['type' => 'int', 'not null' => TRUE], 'generation' => ['type' => 'int', 'not null' => TRUE, 'default' => 0]],
    'primary key' => ['id'],
  ];
  $schema['exact_approval_requests'] = [
    'description' => 'Immutable proposals and their terminal state.',
    'fields' => [
      'id' => $id, 'actor_key' => $id, 'actor_user' => $id, 'actor_tenant' => $id,
      'idempotency_key' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'fingerprint' => $id, 'proposal' => $text, 'digest' => $id,
      'status' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE],
      'reason' => ['type' => 'varchar', 'length' => 128, 'not null' => FALSE],
      'result' => $nullable_text, 'proof' => $nullable_text,
      'created' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'unique keys' => ['idempotency' => ['actor_key', 'idempotency_key']],
    'indexes' => ['owner' => ['actor_tenant', 'actor_user'], 'created' => ['created']],
  ];
  $schema['exact_approval_executions'] = [
    'fields' => ['request_id' => $id, 'record' => $text],
    'primary key' => ['request_id'],
  ];
  $schema['exact_approval_ceremonies'] = [
    'fields' => [
      'id' => $id, 'request_id' => $id, 'nonce' => $id, 'challenge' => $id,
      'expires_at' => ['type' => 'varchar', 'length' => 40, 'not null' => TRUE],
      'options' => $text, 'consumed' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'], 'indexes' => ['request' => ['request_id']],
  ];
  $schema['exact_approval_credentials'] = [
    'description' => 'Public credential sources only. No passkey private keys.',
    'fields' => [
      'credential_hash' => $id, 'credential_id' => $text, 'user_id' => $id, 'tenant_id' => $id,
      'source_json' => $text, 'source_digest' => $id,
      'revoked' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0],
      'label' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE],
      'created' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE],
    ],
    'primary key' => ['credential_hash'], 'indexes' => ['owner' => ['tenant_id', 'user_id']],
  ];
  $schema['exact_approval_evidence'] = [
    'description' => 'One immutable signed evidence bundle and public key snapshot per completed request.',
    'fields' => ['request_id' => $id, 'bundle' => $text, 'credential' => $nullable_text, 'trust' => $text],
    'primary key' => ['request_id'],
  ];
  return $schema;
}

/** Implements hook_install(). */
function exact_approval_install(): void {
  \Drupal::database()->insert('exact_approval_mutex')->fields(['id' => 1, 'generation' => 0])->execute();
}

/** Implements hook_requirements(). */
function exact_approval_requirements(string $phase): array {
  $requirements = [];
  if (in_array($phase, ['install', 'runtime'], TRUE)) {
    if (!class_exists(\ExactApproval\Core\ApprovalService::class) || !class_exists(\ExactApproval\WebAuthn\WebAuthnVerifier::class)) {
      $requirements['exact_approval_libraries'] = ['title' => t('Exact approval libraries'), 'value' => t('Missing Composer dependencies'), 'description' => t('Install the module with Composer and its shared core and WebAuthn packages.'), 'severity' => REQUIREMENT_ERROR];
    }
    $definition = \Drupal::entityTypeManager()->getDefinition('node', FALSE);
    if ($definition !== NULL && !in_array($definition->getStorageClass(), [\Drupal\node\NodeStorage::class, \Drupal\exact_approval\Guard\ApprovalNodeStorage::class], TRUE)) {
      $requirements['exact_approval_storage'] = ['title' => t('Exact approval storage compatibility'), 'value' => t('Custom node storage requires integration'), 'description' => t('This release guards stock node storage. It cannot safely replace another custom storage handler.'), 'severity' => REQUIREMENT_ERROR];
    }
  }
  if ($phase === 'runtime') {
    try {
      \Drupal\exact_approval\Bridge\BridgeFactory::signer();
      \Drupal\exact_approval\Bridge\BridgeFactory::webAuthnConfiguration(\Drupal::configFactory());
      $requirements['exact_approval_configuration'] = ['title' => t('Exact approval signing and passkeys'), 'value' => t('Configured'), 'severity' => REQUIREMENT_OK];
    }
    catch (\Throwable) {
      $requirements['exact_approval_configuration'] = ['title' => t('Exact approval signing and passkeys'), 'value' => t('Setup required'), 'description' => t('Set the private application signing key in settings.php and configure the fixed origin and relying-party ID. Review the module README for generation and backup instructions.'), 'severity' => REQUIREMENT_ERROR];
    }
  }
  return $requirements;
}


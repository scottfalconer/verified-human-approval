#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Sets the example up: the settings (origin, database URL and secrets), then, through `publishing:setup`, the schema,
 * an editor and a reader with their agent tokens and one-time passkey links, and three drafts. It writes the settings
 * to var/settings.php only once all of that worked.
 *
 *     php examples/doctrine-publishing/bin/setup                     SQLite, on a random localhost port
 *     DATABASE_URL='postgresql://app:secret@127.0.0.1:5432/newsroom' php examples/doctrine-publishing/bin/setup
 *     APP_ORIGIN=http://localhost:28417 php examples/doctrine-publishing/bin/setup
 */

use Symfony\Bundle\FrameworkBundle\Console\Application;
use Symfony\Component\Console\Input\ArrayInput;
use Symfony\Component\Console\Output\ConsoleOutput;
use Symfony\Component\Console\Output\NullOutput;
use VerifiedHumanApproval\Core\ChallengeBinding;
use VerifiedHumanApproval\Example\Publishing\PublishingKernel;

require dirname(__DIR__, 3).'/vendor/autoload.php';

// Everything setup creates in var/ (the settings, the SQLite database, the cache) is readable by this account only.
umask(0077);
$root = dirname(__DIR__);
$file = $root.'/var/settings.php';
if (is_file($file)) {
    fwrite(\STDERR, "Already set up: $file exists. To start again, delete examples/doctrine-publishing/var/ (and use a fresh PostgreSQL or MySQL database, if you set one).\n");
    exit(1);
}
// Passkeys belong to an exact origin, port included, so the server must run on this one. The port is random, well away
// from the demo's.
$origin = getenv('APP_ORIGIN') ?: 'http://localhost:'.random_int(20000, 39999);
$keys = sodium_crypto_sign_keypair();
$settings = [
    'APP_ORIGIN' => $origin,
    'APP_SECRET' => bin2hex(random_bytes(32)),
    'DATABASE_URL' => getenv('DATABASE_URL') ?: 'sqlite:///%kernel.project_dir%/var/data.sqlite',
    // The receipt key: it signs every receipt and the audit log. Keep it, and its public key, as long as the records.
    'APPROVAL_RECEIPT_KEY_ID' => 'newsroom-1',
    'APPROVAL_RECEIPT_SECRET_KEY' => ChallengeBinding::encode(sodium_crypto_sign_secretkey($keys)),
    'APPROVAL_RECEIPT_KEY_VALID_FROM' => gmdate('Y-m-d\TH:i:s\Z'),
    'MCP_REQUEST_STATE_KEY' => bin2hex(random_bytes(32)),
];
if (!is_dir($root.'/var') && !mkdir($root.'/var', 0700) && !is_dir($root.'/var')) {
    fwrite(\STDERR, "Could not create $root/var.\n");
    exit(1);
}
foreach ($settings as $name => $value) {
    $_SERVER[$name] = $_ENV[$name] = $value;
}
require $root.'/config/bootstrap.php';

$console = new Application(new PublishingKernel((string) $_SERVER['APP_ENV'], (bool) $_SERVER['APP_DEBUG']));
$console->setAutoExit(false);
if (0 !== $console->run(new ArrayInput(['command' => 'publishing:setup']), new ConsoleOutput())) {
    exit(1);
}
file_put_contents($file, "<?php\n\n// Written by bin/setup. Secrets: keep this file private, and never commit it.\nreturn ".var_export($settings, true).";\n", \LOCK_EX);
chmod($file, 0600);
// The review pages load the bundle's script and stylesheet from public/bundles/, as after any assets:install.
$console->run(new ArrayInput(['command' => 'assets:install', '--symlink' => true, '--relative' => true]), new NullOutput());

$port = parse_url($origin, \PHP_URL_PORT) ?? 80;
echo "\nStart the site, then open $origin/login:\n";
echo "  php -S localhost:$port -t examples/doctrine-publishing/public examples/doctrine-publishing/public/index.php\n";

{% extends '@VerifiedHumanApproval/base.html.twig' %}
{% block title %}Sign in · Newsroom{% endblock %}
{% block body %}
<h1>Sign in</h1>
{% if error %}<p class="notice error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</p>{% endif %}
<form class="card" method="post" action="{{ path('login') }}">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
    <label>Account <input name="_username" value="{{ last_username }}" autocomplete="username" required></label>
    <label>Password <input type="password" name="_password" autocomplete="current-password" required></label>
    <button class="primary">Sign in</button>
</form>
<p class="muted">The setup command printed a password for the editor and for the reader. Signing in lets you ask for changes; only your passkey approves them.</p>
{% endblock %}

#!/bin/sh
# Serves a second copy of the demo on a public HTTPS address through a Cloudflare quick tunnel, for
# claude.ai and phones. Both run under launchd, so they survive Claude restarts.
# The tunnel's hostname changes each time it starts, and passkeys are tied to the hostname,
# so a new hostname gets a fresh public demo. Usage: public start | stop | status
set -eu
ROOT=$(cd "$(dirname "$0")/../../.." && pwd)
RUNTIME="$ROOT/var/public-demo"
PORT=8081
LABEL=dev.verified-human-approval.tunnel
LOG="$ROOT/var/public-tunnel.log"
SERVER="$ROOT/examples/symfony/bin/server"

tunnel_url() { grep -o 'https://[a-z0-9-]*\.trycloudflare\.com' "$LOG" 2>/dev/null | tail -1 || true; }
demo_origin() { php -r '$s = json_decode((string) @file_get_contents($argv[1]), true); echo is_array($s) ? ($s["origin"] ?? "") : "";' "$RUNTIME/settings.json"; }

start() {
  mkdir -p "$ROOT/var"
  if ! launchctl list "$LABEL" >/dev/null 2>&1 || [ -z "$(tunnel_url)" ]; then
    launchctl remove "$LABEL" 2>/dev/null || true
    : > "$LOG"
    launchctl submit -l "$LABEL" -o "$LOG" -e "$LOG" -- "$(command -v cloudflared)" tunnel --no-autoupdate --url "http://localhost:$PORT"
    i=0
    while [ $i -lt 60 ] && [ -z "$(tunnel_url)" ]; do sleep 0.5; i=$((i + 1)); done
  fi
  ORIGIN=$(tunnel_url)
  [ -n "$ORIGIN" ] || { echo "The tunnel did not start; see $LOG"; exit 1; }
  if [ "$(demo_origin)" != "$ORIGIN" ]; then
    PORT=$PORT EXACT_APPROVAL_RUNTIME="$RUNTIME" "$SERVER" stop >/dev/null 2>&1 || true
    (umask 077; EXACT_APPROVAL_RUNTIME="$RUNTIME" EXACT_APPROVAL_ORIGIN="$ORIGIN" php "$ROOT/examples/symfony/bin/setup.php" --reset > "$ROOT/var/public-demo-setup.txt")
    echo "Fresh public demo for $ORIGIN; its credentials are in var/public-demo-setup.txt"
  fi
  PORT=$PORT EXACT_APPROVAL_RUNTIME="$RUNTIME" "$SERVER" start
  echo "Public demo: $ORIGIN"
  echo "claude.ai connector URL: $ORIGIN/mcp"
}

stop() {
  launchctl remove "$LABEL" 2>/dev/null || true
  PORT=$PORT EXACT_APPROVAL_RUNTIME="$RUNTIME" "$SERVER" stop
}

case "${1:-status}" in
  start) start ;;
  stop) stop ;;
  status) echo "Tunnel: $(tunnel_url)"; PORT=$PORT "$SERVER" status ;;
  *) echo "Usage: $0 start | stop | status"; exit 2 ;;
esac

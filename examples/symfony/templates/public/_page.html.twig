{# The council's public alerts page in alert mode. The live page and the approval preview both render this
   template, so the person approves the page exactly as residents will see it. Changing it changes the
   action's version, which invalidates approvals given for the old layout. #}
<header class="rc-header"><div class="rc-wrap"><span class="rc-brand">Riverside Council</span><span class="rc-nav">Emergency alerts · Roads and travel · Bins · Contact us</span></div></header>
<main class="rc-wrap">
    <section class="rc-alert" role="alert">
        <p class="rc-alert-label">⚠ Emergency alert</p>
        <h1 class="rc-title">{{ title }}</h1>
        <div class="rc-body">{{ body|nl2br }}</div>
    </section>
    <p class="rc-note">Issued by Riverside Council emergency management. Follow the instructions of emergency services.</p>
</main>
<footer class="rc-footer"><div class="rc-wrap">Riverside Council · A fictional site for the Verified Human Approval demo</div></footer>

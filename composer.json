{
  "name": "exact-approval/development",
  "description": "Exact action approval for PHP applications, with Symfony and MCP integration.",
  "type": "project",
  "license": "MIT",
  "repositories": [{"type": "path", "url": "packages/*", "options": {"symlink": true}}],
  "require": {
    "php": "^8.3",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-sodium": "*",
    "exact-approval/core": "^0.1",
    "exact-approval/symfony-bundle": "^0.1",
    "exact-approval/webauthn": "^0.1",
    "mcp/sdk": "^0.9",
    "nyholm/psr7": "^1.8",
    "symfony/ai-agent": "^1.0@beta",
    "symfony/ai-mcp-tool": "^1.0@beta",
    "symfony/ai-open-ai-platform": "^1.0@beta",
    "symfony/clock": "^7.4",
    "symfony/form": "^7.4",
    "symfony/framework-bundle": "^7.4",
    "symfony/http-client": "^7.4",
    "symfony/lock": "^7.4",
    "symfony/mcp-bundle": "^1.0@beta",
    "symfony/rate-limiter": "^7.4",
    "symfony/security-bundle": "^7.4",
    "symfony/security-csrf": "^7.4",
    "symfony/twig-bundle": "^7.4",
    "symfony/validator": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "^7.4",
    "symfony/css-selector": "^7.4",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {"psr-4": {"ExactApproval\\Demo\\": "examples/symfony/src/"}},
  "autoload-dev": {"psr-4": {"ExactApproval\\Tests\\": "tests/"}},
  "minimum-stability": "beta",
  "prefer-stable": true,
  "config": {"sort-packages": true, "allow-plugins": {"php-http/discovery": false}, "platform": {"php": "8.3.0"}},
  "scripts": {"test": "@php vendor/bin/phpunit", "analyse": "@php vendor/bin/phpstan analyse --memory-limit=512M"}
}

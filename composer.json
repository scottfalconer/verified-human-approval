{
  "name": "verified-human-approval/verified-human-approval",
  "description": "Verified Human Approval monorepo: the library packages, the Symfony bundle, the demo application and the examples. Install the packages, not this.",
  "type": "project",
  "license": "MIT",
  "homepage": "https://github.com/scottfalconer/verified-human-approval",
  "require": {
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-sodium": "*",
    "php": "^8.3",
    "chillerlan/php-qrcode": "^5.0",
    "mcp/sdk": "^0.9",
    "nyholm/psr7": "^1.8",
    "psr/clock": "^1.0",
    "root23/php-json-canonicalization": "^1.0",
    "symfony/ai-agent": "^1.0@beta",
    "symfony/ai-mcp-tool": "^1.0@beta",
    "symfony/ai-open-ai-platform": "^1.0@beta",
    "symfony/clock": "^7.4 || ^8.0",
    "symfony/form": "^7.4",
    "symfony/framework-bundle": "^7.4 || ^8.0",
    "symfony/http-client": "^7.4",
    "symfony/lock": "^7.4 || ^8.0",
    "symfony/mcp-bundle": "^1.0@beta",
    "symfony/rate-limiter": "^7.4 || ^8.0",
    "symfony/security-bundle": "^7.4 || ^8.0",
    "symfony/security-csrf": "^7.4 || ^8.0",
    "symfony/twig-bundle": "^7.4 || ^8.0",
    "symfony/validator": "^7.4",
    "web-auth/webauthn-lib": "^5.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "^7.4",
    "symfony/css-selector": "^7.4",
    "phpstan/phpstan": "^2.1"
  },
  "replace": {
    "verified-human-approval/core": "self.version",
    "verified-human-approval/webauthn": "self.version",
    "verified-human-approval/mcp": "self.version",
    "verified-human-approval/symfony-bundle": "self.version"
  },
  "autoload": {
    "psr-4": {
      "VerifiedHumanApproval\\Core\\": "src/core/src/",
      "VerifiedHumanApproval\\WebAuthn\\": "src/webauthn/src/",
      "VerifiedHumanApproval\\Mcp\\": "src/mcp/src/",
      "VerifiedHumanApproval\\Bundle\\": "src/symfony-bundle/src/",
      "VerifiedHumanApproval\\Demo\\": "demo/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "VerifiedHumanApproval\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "beta",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": false
    },
    "platform": {
      "php": "8.3.0"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit",
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=512M"
  }
}

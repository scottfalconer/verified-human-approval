{
  "name": "verified-human-approval/webauthn",
  "description": "WebAuthn user-verification bridge for exact application action approval.",
  "keywords": ["webauthn", "passkeys", "approval", "user-verification"],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-sodium": "*",
    "paragonie/constant_time_encoding": "^2.6 || ^3.0",
    "symfony/serializer": "^6.4 || ^7.0 || ^8.0",
    "verified-human-approval/core": "self.version",
    "web-auth/webauthn-lib": "^5.3.11"
  },
  "suggest": {
    "ext-pdo": "Use the included transaction-compatible credential repository.",
    "ext-pdo_sqlite": "Run the SQLite reference implementation."
  },
  "autoload": {
    "psr-4": {
      "VerifiedHumanApproval\\WebAuthn\\": "src/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "homepage": "https://github.com/scottfalconer/verified-human-approval",
  "support": {
    "issues": "https://github.com/scottfalconer/verified-human-approval/issues",
    "source": "https://github.com/scottfalconer/verified-human-approval",
    "security": "https://github.com/scottfalconer/verified-human-approval/security/policy",
    "docs": "https://github.com/scottfalconer/verified-human-approval/tree/main/docs"
  },
  "bin": [
    "bin/verify-evidence.php"
  ]
}

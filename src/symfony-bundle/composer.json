{
  "name": "verified-human-approval/symfony-bundle",
  "description": "Verified Human Approval for Symfony: an agent asks through MCP, the person approves the exact action with a passkey on your site, and the application executes the stored proposal once.",
  "keywords": ["symfony", "symfony-bundle", "mcp", "passkeys", "webauthn", "approval", "ai-agents"],
  "type": "symfony-bundle",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/scottfalconer/verified-human-approval/issues",
    "source": "https://github.com/scottfalconer/verified-human-approval",
    "security": "https://github.com/scottfalconer/verified-human-approval/security/policy",
    "docs": "https://github.com/scottfalconer/verified-human-approval/tree/main/docs"
  },
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "verified-human-approval/core": "self.version",
    "verified-human-approval/mcp": "self.version",
    "chillerlan/php-qrcode": "^5.0",
    "mcp/sdk": "^0.9",
    "psr/cache": "^1.0 || ^2.0 || ^3.0",
    "psr/event-dispatcher": "^1.0",
    "psr/log": "^1.1 || ^2.0 || ^3.0",
    "symfony/mcp-bundle": "^1.0",
    "symfony/framework-bundle": "^7.4 || ^8.0",
    "symfony/security-bundle": "^7.4 || ^8.0",
    "symfony/twig-bundle": "^7.4 || ^8.0",
    "symfony/asset": "^7.4 || ^8.0",
    "symfony/security-csrf": "^7.4 || ^8.0",
    "symfony/rate-limiter": "^7.4 || ^8.0",
    "symfony/lock": "^7.4 || ^8.0",
    "symfony/clock": "^7.4 || ^8.0",
    "symfony/console": "^7.4 || ^8.0",
    "symfony/config": "^7.4 || ^8.0",
    "symfony/dependency-injection": "^7.4 || ^8.0",
    "symfony/event-dispatcher": "^7.4 || ^8.0",
    "symfony/http-foundation": "^7.4 || ^8.0",
    "symfony/http-kernel": "^7.4 || ^8.0",
    "symfony/routing": "^7.4 || ^8.0",
    "symfony/security-core": "^7.4 || ^8.0",
    "twig/twig": "^3.12"
  },
  "suggest": {
    "verified-human-approval/doctrine": "persistence.driver \"doctrine\": the approval store, signed audit log and passkey repository on a DoctrineBundle connection."
  },
  "autoload": {
    "psr-4": {
      "VerifiedHumanApproval\\Bundle\\": "src/"
    }
  },
  "homepage": "https://github.com/scottfalconer/verified-human-approval"
}

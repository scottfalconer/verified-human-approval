{% extends '@VerifiedHumanApproval/base.html.twig' %}
{% trans_default_domain 'VerifiedHumanApproval' %}
{% block title %}{{ 'Open the approval'|trans }}{% endblock %}
{% block body %}<section class="card approval-sheet"><h1>{{ 'Open the approval on this phone'|trans }}</h1><p>{{ 'This one-time code opens a single request for you to review. Approving still takes your passkey.'|trans }}</p>
<form method="post"><input type="hidden" name="_token" value="{{ csrf }}"><div class="actions"><button class="primary" type="submit">{{ 'Continue'|trans }}</button></div></form></section>{% endblock %}

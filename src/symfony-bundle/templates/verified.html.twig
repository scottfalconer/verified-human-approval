{% extends '@VerifiedHumanApproval/base.html.twig' %}
{% trans_default_domain 'VerifiedHumanApproval' %}
{% block title %}{{ approval ? 'Approved with a passkey'|trans : 'Approval not verified'|trans }}{% endblock %}
{% block body %}
{% if approval %}
<section class="card verification-sheet">
    <p class="eyebrow">{{ 'Verified approval · %application%'|trans({'%application%': approval.application}) }}</p>
    <h1>{{ 'Approved with a passkey'|trans }}</h1>
    <div class="done"><p class="notice outcome"><span><strong>{{ approval.title }}</strong> {{ 'A person approved this exact change with their passkey, and this site signed a receipt as it took effect.'|trans }}</span></p></div>
    <p class="statement">{{ approval.statement }}</p>
    <dl>
        <dt>{{ 'Approved'|trans }}</dt><dd>{{ approval.approvedAt|date('j F Y, H:i:s T') }}</dd>
        <dt>{{ 'Took effect'|trans }}</dt><dd>{{ approval.committedAt|date('j F Y, H:i:s T') }}</dd>
        {# The link goes in after the sentence is escaped, so a translation of it stays text. #}
        {% set key_link %}<a href="{{ path('verified_human_approval_receipt_keys') }}">{{ 'published keys'|trans }}</a>{% endset %}
        <dt>{{ 'Receipt'|trans }}</dt><dd>{{ 'Signed with key %key_id% as the change committed, and it verifies against this site’s %published_keys%.'|trans({'%key_id%': approval.keyId})|e|replace({'%published_keys%': key_link})|raw }}</dd>
    </dl>
</section>
<section class="card">
    <h2>{{ 'What this shows, and what it doesn’t'|trans }}</h2>
    <p>{{ 'The person who asked approved this exact statement and content with the passkey enrolled for their account, which their device unlocks with a fingerprint, face, PIN or similar. The change ran once, and the site signed its receipt as the change committed. A page shows this badge only while it shows exactly the approved content.'|trans }}</p>
    <p class="muted">{{ 'This page does not name the person. It shows the signed receipt, which holds only digests; the person who approved keeps the full record, which anyone can check against the same key.'|trans }}</p>
    <details><summary>{{ 'The signed receipt'|trans }}</summary>
        <pre>{{ approval.manifest }}</pre>
        <p class="small">{{ 'Signature'|trans }} <code>{{ approval.signature }}</code></p>
    </details>
</section>
<p class="muted small">{{ 'Request'|trans }} <code>{{ approval.requestId }}</code></p>
{% else %}
<section class="card">
    <h1>{{ 'This approval can’t be verified here'|trans }}</h1>
    <p class="muted">{{ 'There is no approval with a passkey on record for this link, or its record no longer verifies.'|trans }}</p>
</section>
{% endif %}
{% endblock %}

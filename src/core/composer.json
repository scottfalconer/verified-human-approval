{
  "name": "verified-human-approval/core",
  "description": "The framework-neutral engine of Verified Human Approval: it freezes an action's exact proposal, checks current permissions again and executes the approved proposal once in one database transaction, with signed receipts and a signed audit log.",
  "keywords": ["approval", "human-in-the-loop", "ai-agents", "audit-log", "receipts", "ed25519"],
  "type": "library",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/scottfalconer/verified-human-approval/issues",
    "source": "https://github.com/scottfalconer/verified-human-approval",
    "security": "https://github.com/scottfalconer/verified-human-approval/security/policy",
    "docs": "https://github.com/scottfalconer/verified-human-approval/tree/main/docs"
  },
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-mbstring": "*",
    "psr/clock": "^1.0",
    "psr/log": "^1.1 || ^2.0 || ^3.0"
  },
  "suggest": {
    "ext-pdo": "Reference SQLite transactional persistence.",
    "ext-pdo_sqlite": "Reference SQLite transactional persistence.",
    "ext-sodium": "Signed receipts, the signed audit log and checking either."
  },
  "autoload": {
    "psr-4": {
      "VerifiedHumanApproval\\Core\\": "src/"
    }
  },
  "homepage": "https://github.com/scottfalconer/verified-human-approval"
}

{
  "name": "verified-human-approval/core",
  "description": "Immutable, caller-bound approval and atomic local action execution for PHP.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-mbstring": "*",
    "psr/clock": "^1.0",
    "root23/php-json-canonicalization": "^1.0"
  },
  "suggest": {
    "ext-pdo": "Reference SQLite transactional persistence.",
    "ext-pdo_sqlite": "Reference SQLite transactional persistence.",
    "ext-sodium": "Signed execution receipts."
  },
  "autoload": {
    "psr-4": {
      "VerifiedHumanApproval\\Core\\": "src/"
    }
  },
  "homepage": "https://github.com/scottfalconer/verified-human-approval"
}
